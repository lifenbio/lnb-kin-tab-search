# 로컬 개발 환경. 값 채워서 .env.dev로 복사. .env.dev는 git 추적 안 됨.
DEBUG=1
SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_HOST=db
SQL_PORT=5432

# AWS (S3 daily-excel-data 등)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# 메일 (네이버 SMTP)
EMAIL_HOST=smtp.naver.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587

# 네이버 검색광고 API
NAVER_AD_BASE_URL=https://api.naver.com
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# 메일 수신자 (콤마 구분, 미설정 시 services/naver_in.py의 prod 기본값 사용)
# 테스트 환경에선 본인 메일로 오버라이드 권장
DAILY_EXCEL_RECIPIENTS=
DETAIL_VIEW_RECIPIENTS=
